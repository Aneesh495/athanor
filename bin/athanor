#!/usr/bin/env bash
# Athanor launcher - Equality saturation superoptimizer and program synthesis kernel

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

SBCL_BIN=""
if [ -x "/opt/homebrew/bin/sbcl" ]; then
    SBCL_BIN="/opt/homebrew/bin/sbcl"
elif command -v sbcl >/dev/null 2>&1; then
    SBCL_BIN="$(command -v sbcl)"
elif [ -x "/usr/local/bin/sbcl" ]; then
    SBCL_BIN="/usr/local/bin/sbcl"
else
    echo "Error: Steel Bank Common Lisp (sbcl) not found on PATH." >&2
    exit 1
fi

LOAD_SCRIPT="${REPO_DIR}/src/cli/loader.lisp"

exec "${SBCL_BIN}" --noinform \
    --load "${LOAD_SCRIPT}" \
    --eval "(athanor::cli-main (cdr sb-ext:*posix-argv*))" \
    --end-toplevel-options "$@"
